{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brand Tokens",
  "description": "Single source of truth for brand tokens (DRY).",
  "type": "object",
  "required": ["original", "target"],
  "properties": {
    "original": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "org": { "type": "string" },
        "domain": { "type": "string" },
        "package": { "type": "string" },
        "namespace": { "type": "string" },
        "colors": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "org": { "type": "string" },
        "domain": { "type": "string" },
        "package": { "type": "string" },
        "namespace": { "type": "string" },
        "tagline": { "type": "string" },
        "colors": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
